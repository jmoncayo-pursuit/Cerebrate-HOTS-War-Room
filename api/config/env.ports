# Port Configuration - SINGLE SOURCE OF TRUTH
# DO NOT change these without updating ALL references!

# API Server (Python - Flask)
API_PORT=5001

# Frontend (Vite - React)
FRONTEND_PORT=5173

# Replay Watcher Status File
WATCHER_STATUS_PORT=5001  # Uses API server for status

# IMPORTANT: These ports are FIXED by design for predictability
# If you need to change them, update this file AND:
# 1. vite.config.js (proxy configuration)
# 2. src/config.js (API_BASE_URL)
# 3. api_server.py (Flask port)
# 4. start_server.sh (port checks)
# 5. package.json (dev server port)
